# WorkSeal Demo App Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env with real secrets.

# PostgreSQL connection string for the demo database
DATABASE_URL=postgresql://user:password@localhost:5432/workseal_demo?schema=public

# Password for the seeded demo user (demo@workseal.test)
DEMO_USER_PASSWORD=

# Express session signing secret — use a long random string in any shared environment
SESSION_SECRET=

# Controlled failure mode for the Create Ticket acceptance criterion demo
# Set to true to make POST /api/tickets return HTTP 500 (demonstrates the fail→fix→reverify loop)
# Set to false for normal operation
DEMO_FAILURE_MODE=false
