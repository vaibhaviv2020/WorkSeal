# WorkSeal Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env with real secrets.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/workseal?schema=public

# Google Gemini AI planner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server port (default: 5000)
PORT=5000

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Allowlisted application origins for verification (comma-separated)
WORKSEAL_ALLOWED_APPLICATION_ORIGINS=http://localhost:5174

# Demo credentials (used by the deterministic executor at runtime — never sent to the LLM)
DEMO_USERNAME=demo@workseal.test
DEMO_PASSWORD=

# Razorpay — planned / not yet implemented
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
